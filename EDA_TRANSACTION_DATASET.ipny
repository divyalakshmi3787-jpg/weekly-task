       8 non-null      object\n"," 2   Amount         8 non-null      int64 \n","dtypes: int64(2), object(1)\n","memory usage: 324.0+ bytes\n"]}]},{"cell_type":"code","source":["total_records = len(df)\n","mean_amount   = np.mean(df[\"Amount\"])\n","variance      = np.var(df[\"Amount\"], ddof=1)\n","maximum       = np.max(df[\"Amount\"])\n","minimum       = np.min(df[\"Amount\"])\n","\n","print(\"Total Records :\", total_records)\n","print(\"Mean Amount :\", round(mean_amount, 2))\n","print(\"Variance :\", round(variance, 2))\n","print(\"Maximum Amount :\", maximum)\n","print(\"Minimum Amount :\", minimum)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_0uuascMFnKm","executionInfo":{"status":"ok","timestamp":1793771090621,"user_tz":-330,"elapsed":20,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"f57c42a6-1864-465b-8240-a8e73f389b23"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Total Records : 8\n","Mean Amount : 512.5\n","Variance : 126964.29\n","Maximum Amount : 1200\n","Minimum Amount : 100\n"]}]},{"cell_type":"code","source":["memory = df.memory_usage(deep=True)\n","print(memory)\n","print(\"\\nTotal Memory Used:\", memory.sum(), \"bytes\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_866lx7fFrCG","executionInfo":{"status":"ok","timestamp":1793771103110,"user_tz":-330,"elapsed":10,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"4a2ea7f9-8133-49d5-8776-5f68d7ed2a81"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Index            132\n","TransactionID     64\n","Category         433\n","Amount            64\n","dtype: int64\n","\n","Total Memory Used: 693 bytes\n"]}]},{"cell_type":"code","source":["with open(\"transaction_dataset.csv.xls\",\"r\") as file:\n","    print(file.read())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"V8JArYQpFuFg","executionInfo":{"status":"ok","timestamp":1793771205856,"user_tz":-330,"elapsed":23,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"2f64abdf-0686-4f12-df2b-48f9a9d7ecf6"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["TransactionID,Category,Amount\n","1001,Food,250\n","1002,Travel,800\n","1003,Food,300\n","1004,Shopping,1200\n","1005,Travel,450\n","1006,Food,100\n","1007,Bills,650\n","1008,Food,350\n","\n"]}]},{"cell_type":"code","source":["def parse_csv(filename):\n","    with open(filename,\"r\",buffering=8192) as file:\n","        next(file)\n","        for line in file:\n","            line = line.strip()\n","            if not line:\n","                continue\n","\n","            yield line.split(\",\")"],"metadata":{"id":"FXtzsQpNFwnB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["for row in parse_csv(\"transaction_dataset.csv.xls\"):\n","    print(row)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oL6e12mNGSo-","executionInfo":{"status":"ok","timestamp":1793771279344,"user_tz":-330,"elapsed":9,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"e91418b1-8a24-4618-8e88-2c1199cb92cc"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["['1001', 'Food', '250']\n","['1002', 'Travel', '800']\n","['1003', 'Food', '300']\n","['1004', 'Shopping', '1200']\n","['1005', 'Travel', '450']\n","['1006', 'Food', '100']\n","['1007', 'Bills', '650']\n","['1008', 'Food', '350']\n"]}]},{"cell_type":"code","source":["def process_file(filename):\n","    count = 0\n","    mean = 0\n","    M2 = 0\n","\n","    category_frequency = {}\n","\n","    for row in parse_csv(filename):\n","        transaction_id = row[0]\n","        category = row[1]\n","        amount = float(row[2])\n","\n","        count += 1\n","\n","        # Welford's algorithm for mean and variance\n","        delta = amount - mean\n","        mean += delta / count\n","\n","        delta2 = amount - mean\n","        M2 += delta * delta2\n","\n","        # Count frequency of each category\n","        if category in category_frequency:\n","            category_frequency[category] += 1\n","        else:\n","            category_frequency[category] = 1\n","\n","    variance = M2 / (count - 1) if count > 1 else 0\n","\n","    return count, mean, variance, category_frequency"],"metadata":{"id":"e7O_-LXkGZG1"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["count, mean, variance, category_frequency = process_file(\"transaction_dataset.csv.xls\")\n","\n","print(\"Total Records :\", count)\n","print(\"Running Mean  :\", round(mean, 2))\n","print(\"Variance      :\", round(variance, 2))\n","\n","print(\"\\nCategory Frequencies\")\n","\n","for category, freq in category_frequency.items():\n","    print(category,\":\", freq)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rzJOcbU1Gd2S","executionInfo":{"status":"ok","timestamp":1793771402029,"user_tz":-330,"elapsed":26,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"b475fbe8-a9ab-4af8-94cc-51fba6f6e557"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Total Records : 8\n","Running Mean  : 512.5\n","Variance      : 126964.29\n","\n","Category Frequencies\n","Food : 4\n","Travel : 2\n","Shopping : 1\n","Bills : 1\n"]}]},{"cell_type":"code","source":["import os\n","file_size = os.path.getsize(\"transaction_dataset.csv.xls\")\n","print(\"File Size:\", file_size, \"bytes\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Sw6Cj26IGydK","executionInfo":{"status":"ok","timestamp":1793771427226,"user_tz":-330,"elapsed":21,"user":{"displayName":"Divya Lakshmi","userId":"14008296391787371959"}},"outputId":"48309869-903b-460d-c3d7-b22b96b2c94d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["File Size: 161 bytes\n"]}]}]}